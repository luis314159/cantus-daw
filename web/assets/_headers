/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed build files never change under the same name (the script and the WebAssembly; every
# style sheet is inlined in the page since round 39). Add a rule here for any new hashed file.
/cantus-web-*
  Cache-Control: public, max-age=31536000, immutable

# Fonts, pictures and sounds keep their names: a day, then revalidate (a week for the fonts,
# which change only with the typeface). One rule per folder in assets/.
/fonts/*
  Cache-Control: public, max-age=604800
/program/*
  Cache-Control: public, max-age=86400
/units/*
  Cache-Control: public, max-age=86400
/studio/*
  Cache-Control: public, max-age=86400
/session/*
  Cache-Control: public, max-age=86400
/ai/*
  Cache-Control: public, max-age=86400
/score/*
  Cache-Control: public, max-age=86400
/press/*
  Cache-Control: public, max-age=86400
/manual/img/*
  Cache-Control: public, max-age=86400
/demos/*
  Cache-Control: public, max-age=86400
/fx/*
  Cache-Control: public, max-age=86400
