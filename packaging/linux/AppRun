#!/bin/sh
# Cantus's AppImage starts here (packaging/linux/build-appimage.sh, ADR 0065).
HERE="$(dirname "$(readlink -f "$0")")"

# Libraries the system may lack, each with its own fallback folder: libpipewire (linked;
# the stand-in lets the program load, and the PipeWire host is simply not offered) and
# libxkbcommon-x11 (winit needs it for an X11 window).
have_lib() {
  for d in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib64 /lib64 /usr/lib /lib; do
    [ -e "$d/$1" ] && return 0
  done
  for l in ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
    if command -v "$l" >/dev/null 2>&1; then
      "$l" -p 2>/dev/null | grep -q "$1" && return 0
      break
    fi
  done
  return 1
}
fallback() { # <library> <folder> <forced?>
  if [ "$3" = 1 ] || ! have_lib "$1"; then
    LD_LIBRARY_PATH="$HERE/usr/lib/fallback/$2${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
  fi
}
# (CANTUS_FORCE_PIPEWIRE_FALLBACK=1 takes the stand-in anyway: packaging/linux/test-fallback.sh.)
fallback libpipewire-0.3.so.0 pipewire "${CANTUS_FORCE_PIPEWIRE_FALLBACK:-0}"
fallback libxkbcommon-x11.so.0 xkb 0

# The .desktop file and icons inside, for desktop integration tools (AppImageLauncher,
# Gear Lever) and for the menu entry Cantus writes itself (linux_desktop.rs).
export CANTUS_APPDIR="$HERE"
exec "$HERE/usr/bin/cantus" "$@"
