<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions Cantus needs (ADR 0066), for the app, cantus-scan and
     cantus-sandbox alike (all three load plug-ins):
     - audio input: recording (with NSMicrophoneUsageDescription, the system asks the user);
     - library validation off: third-party plug-ins are signed by their makers, not by us.
     No JIT and no unsigned executable memory: Cantus generates no code at run time. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
