+/// The RVR1960 file, when the tree holds it: the owner's private tree keeps it while its
+/// publisher's written permission is pending (`verse::RVR1960_PERMITTED`), the public
+/// repository does not (ADR 0049). Its list is kept right whenever it is there. (Leaked:
+/// `verse::parse` keeps `&'static str`s, as it does for the bundled files.) Only a file
+/// that does not exist, while the RVR1960 is not permitted, counts as absent: any other
+/// read error fails the test rather than skip its checks.
+fn rvr1960() -> Option<Vec<verse::Verse>> {
+    let path = concat!(env!("CARGO_MANIFEST_DIR"), "/locales/verses/es.txt");
+    match std::fs::read_to_string(path) {
+        Ok(src) => Some(verse::parse(src.leak()).expect("the RVR1960 file parses")),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound && !verse::RVR1960_PERMITTED => None,
+        Err(e) => panic!(
+            "{path}: {e} (RVR1960 permitted: {})",
+            verse::RVR1960_PERMITTED
+        ),
+    }
 }
 
